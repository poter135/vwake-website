{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vwake-website",
  "main": "src/creator-link-worker.mjs",
  "compatibility_date": "2026-06-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CREATOR_LINK_BACKEND_URL": "https://asia-east1-vwake-2026.cloudfunctions.net/resolveCreatorShortLink"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
